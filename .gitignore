# Real patient data — NEVER commit (PIPL/GDPR)
# NOTE: data/combine_cache.feather is a symlink into rawinputdata/ and is caught
# by the *.feather rule above. Both rules must stay.
rawinputdata/
results/**/*.pkl
.gstack/

# Local machine config (was only covered by the user's global gitignore)
.claude/settings.local.json

# public benchmark tables (downloaded, never committed); provenance note stays tracked
data/benchmarks/*.csv
data/benchmarks/*.data
data/benchmarks/*.test

# Figure rasters. Regenerated deterministically by the R scripts beside them
# (`make figures`), so ~200 MB of 600-dpi TIFF has no business in history. The
# SVG and PDF stay tracked: they are small, and the PDF is what LaTeX includes.
paper/custody/figures/*.tiff
paper/custody/figures/*.png

# Submission package: a build product. Every file is copied or generated from a
# tracked source by tools/build_submission_package.py, and it is ~195 MB of
# 600-dpi TIFF. Rebuild with `make package`; never author inside it.
paper/custody/submission_package/

# LaTeX build tree: generated by tools/build_custody_latex.py from the same
# Markdown as the draft, and it carries latexmk's aux/log churn. Rebuild with
# `make latex`.
paper/custody/latex/

# Deposit bundle: regenerated byte-for-byte by tools/build_deposit.py from the
# demonstration substrate at a fixed seed. Rebuild with `make deposit`.
paper/custody/deposit/
.mypy_cache/
.ruff_cache/
